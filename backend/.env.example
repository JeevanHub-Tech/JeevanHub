PORT=5000
NODE_ENV=development
MDB=mongodb://localhost:27017/ayurveda
JWT_SECRET=your_jwt_secret_here
REFRESH_TOKEN_SECRET=your_refresh_token_secret_here    # Required, must differ from JWT_SECRET, >=32 chars
ADMIN_PASSWORD=your_secure_admin_password_here
ADMIN_EMAIL=admin@jeevanhub.com

AYURVEDA_BACKEND_URL=http://localhost:5000
AYURVEDA_NLP_URL=http://localhost:8000
BASE_URL=http://localhost:5000

WHATSAPP_TOKEN=your_whatsapp_token_here
PHONE_NUMBER_ID=your_phone_number_id_here
VERIFIED_USER_NUMBER=your_verified_user_number_here

FRONTEND_URL=http://localhost:3000

# --- AI Chatbot (Sanjeevani AI) --------------------------
GROQ_API_KEY=your_groq_api_key_here    # Required - get from https://console.groq.com
YOUTUBE_API_KEY=your_youtube_api_key_here # Optional - enables rich video recommendations

CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

# --- Payments & Payouts (Cashfree) -----------------------------------
CASHFREE_APP_ID=your_cashfree_pg_app_id_here
CASHFREE_SECRET_KEY=your_cashfree_pg_secret_key_here
CASHFREE_ENV=PROD                                   # PROD or TEST
CASHFREE_API_VERSION=2023-08-01

# Cashfree Payouts (for Automated Retailer & Doctor Disbursements)
CASHFREE_PAYOUT_CLIENT_ID=your_cashfree_payout_client_id_here
CASHFREE_PAYOUT_CLIENT_SECRET=your_cashfree_payout_client_secret_here
CASHFREE_PAYOUT_ENV=TEST                            # TEST for sandbox, PROD for live
CASHFREE_PAYOUT_API_VERSION=2024-01-01
CASHFREE_PAYOUT_SIMULATE=false

# Commission Rates & Lock-in Windows
RETAILER_COMMISSION_PERCENT=2                       # Platform fee: 2% on items subtotal
RETAILER_PAYOUT_HOLD_DAYS=7                         # Lock-in window: 7 days post-delivery
DOCTOR_COMMISSION_PERCENT=12                        # Platform fee: 12% on consultation/diet plan
DOCTOR_PAYOUT_HOLD_DAYS=7                           # Lock-in window: 7 days post-consultation
# Optional: Shorten hold in minutes for testing (e.g. 2 minutes)
# PAYOUT_HOLD_MINUTES=2

# --- Video calls (Daily.co) --------------------------------
DAILY_API_KEY=your_daily_api_key_here   # Required for doctor-patient video calls, get from https://dashboard.daily.co

# --- Payout settlement cron ---------------------------------
# Shared secret an external cron pinger (e.g. cron-job.org) sends as the
# x-cron-secret header when hitting GET/POST /api/cron/settle-payouts.
# Generate with: openssl rand -hex 32
CRON_SECRET=your_long_random_secret_here
# Marketplace commission retained by platform on product sales (in percent)
PLATFORM_COMMISSION_PERCENT=2

# --- Delhivery order tracking -------------------------------
# AES-256-GCM key encrypting retailer Delhivery credentials at rest.
# REQUIRED before any retailer can connect Delhivery. Exactly 64 hex chars.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating it invalidates stored credentials -- retailers must re-save them.
DELHIVERY_ENCRYPTION_KEY=64_hex_characters_here

# Webhook URLs handed to retailers are built from BASE_URL (set near the top of
# this file). Delhivery must be able to reach it, so locally point BASE_URL at an
# ngrok/cloudflared tunnel rather than http://localhost.

# Optional. Fallback webhook secret when one shared Delhivery registration is
# used for the whole platform instead of a per-retailer secret.
# DELHIVERY_WEBHOOK_SECRET=

# Optional overrides
# DELIVERY_POLL_CRON=0 */6 * * *                                     # in-process tracking sweep schedule (IST)
# DELHIVERY_TRACKING_URL=https://track.delhivery.com/api/v1/packages/json/

# Local testing without a Delhivery account: tracking is simulated and no
# request leaves the server. The AWB picks the scenario (DL=delivered,
# RT=return, UD=failed attempt, BAD=unknown waybill). Ignored entirely when
# NODE_ENV=production, so it cannot fake a delivery on the live site.
# DELHIVERY_SANDBOX=true
